# "worker" service — node-cron polling + expiration sweep (PRD §11.1, §11.2)
# Separate long-running process from "web", sharing the same Drizzle
# schema and DB — connects to the "db" Postgres service over the network,
# so there's no shared-volume dependency for the database itself (only
# the assets volume). Runs via tsx rather than a compiled build — this is
# a small cron loop, not a perf-critical path.
FROM node:22-slim
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps

COPY . .

CMD ["npx", "tsx", "worker/index.ts"]
