# "worker" service — node-cron polling + expiration sweep (PRD §11.1, §11.2)
# Separate long-running process from "web", sharing the same Drizzle
# schema and DB volume. Runs via tsx rather than a compiled build —
# this is a small cron loop, not a perf-critical path.
FROM node:22-slim
# python3/make/g++: required to build better-sqlite3's native addon
RUN apt-get update -y && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps

COPY . .

CMD ["npx", "tsx", "worker/index.ts"]
